{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "dependencyDashboard": {
    "enabled": false
  },
  "minimumReleaseAge": "10 days",
  "mode": "full",
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "matchPackageNames": [
        "mthalman/release-automation",
        "mthalman/release-automation/**"
      ],
      "groupName": "release automation"
    }
  ]
}
